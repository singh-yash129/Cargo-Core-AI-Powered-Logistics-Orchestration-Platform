' ══════════════════════════════════════════════
' RELATIONSHIPS
' ══════════════════════════════════════════════

' Auth
Role "1" <-- "0..*" User : has

' Order relationships
User "1" --> "0..*" Order : places
User "1" --> "0..*" CustomerQuote : requests
User "1" --> "0..*" DamageReport : submits
Order "1" *-- "1..*" OrderItem : contains
Order "1" *-- "0..*" PickedItem : tracked by
Order "1" --> "0..1" QualityCheck : verified by
Order "1" --> "0..1" ReturnGrading : graded by
Order "1" --> "0..1" LoadingDock : loaded at
Order "1" --> "0..1" PackingStation : packed at
CustomerQuote ..> Order : converts to

' Warehouse relationships
Warehouse "1" *-- "0..*" LoadingDock : has
Warehouse "1" *-- "0..*" PackingStation : has
Warehouse "1" --> "0..*" InventoryItem : stores
Warehouse "1" --> "0..*" Labourer : employs
Warehouse "1" --> "0..*" LogisticsVehicle : manages
Warehouse "1" --> "0..*" LogisticsZone : defines
Warehouse "1" --> "0..*" WarehouseZoneMetrics : tracks
Warehouse "1" --> "0..1" RateGovernance : configured by

' Inventory relationships
InventoryItem "1" *-- "0..*" InventoryMovement : records
InventoryItem "1" --> "0..*" RestockRequest : triggers

' Labour relationships
User "1" --> "0..1" Labourer : has profile
Labourer "1" *-- "0..*" LabourAttendance : logs
PackingStation "0..1" --> "0..1" Labourer : assigned to

' Logistics relationships
User "1" --> "0..1" LogisticsDriverProfile : has
User "1" --> "0..1" LogisticsVehicle : drives
