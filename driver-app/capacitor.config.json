{
    "appId": "com.cargocoredriver.app",
    "appName": "Cargo-Core Driver",
    "webDir": "dist",
    "server": {
        "androidScheme": "http",
        "url": "http://10.0.2.2:5174",
        "cleartext": true
    },
    "plugins": {
        "SplashScreen": {
            "launchShowDuration": 0,
            "showSpinner": false
        },
        "Keyboard": {
            "resize": "none",
            "style": "dark"
        },
        "StatusBar": {
            "style": "DARK",
            "overlaysWebView": true
        },
        "Camera": {
            "iosUsageDescription": "Cargo-Core needs camera access to capture proof of delivery photos and fuel receipts."
        },
        "Geolocation": {
            "iosUsageDescription": "Cargo-Core uses your location to provide navigation and automatic geofence arrival detection."
        }
    },
    "android": {
        "buildOptions": {
            "keystorePath": "release.keystore",
            "keystoreAlias": "key0"
        }
    }
}