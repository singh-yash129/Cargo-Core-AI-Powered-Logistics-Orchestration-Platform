# Backend API Configuration
# Web browser:
VITE_API_BASE_URL=http://localhost:8000

# Optional Android override:
# - Real phone over USB: keep localhost and run `adb reverse tcp:8000 tcp:8000`
# - Android emulator:     http://10.0.2.2:8000
# - Real phone over Wi-Fi:http://<your-computer-ip>:8000
# VITE_API_BASE_URL_ANDROID=http://192.168.1.25:8000

# For production:
# VITE_API_BASE_URL=https://api.cargocore.com
