<template>
    <div class="screen-layout" :class="isDark ? 'bg-background-dark text-white' : 'bg-background-light text-gray-900'">

        <!-- Header -->
        <header class="flex-shrink-0 px-5 pt-5 pb-4 flex items-center justify-between border-b"
            :class="isDark ? 'border-white/5' : 'border-gray-100'">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-ai-blue mb-0.5">AI Voice Assistant</p>
                <h1 class="text-2xl font-black tracking-tight">CargoAI ✦</h1>
            </div>
            <button @click="$router.back()" class="w-10 h-10 rounded-full flex items-center justify-center border"
                :class="isDark ? 'bg-surface-dark border-white/5 text-gray-400' : 'bg-white border-gray-200 shadow-sm'">
                <span class="material-icons text-xl">close</span>
            </button>
        </header>

        <!-- Waveform placeholder -->
        <div class="screen-body flex flex-col items-center justify-center px-5 gap-6">

            <!-- AI Avatar -->
            <div class="relative">
                <div class="absolute inset-0 bg-ai-blue/20 rounded-full blur-3xl animate-pulse-slow"></div>
                <div class="relative w-32 h-32 rounded-full flex items-center justify-center border-2"
                    :class="listening ? 'bg-ai-blue/20 border-ai-blue/50' : isDark ? 'bg-surface-dark border-white/10' : 'bg-white border-gray-200'"
                    :style="listening ? 'box-shadow: 0 0 40px rgba(77,163,255,0.3)' : ''">
                    <span class="material-icons text-6xl"
                        :class="listening ? 'text-ai-blue' : isDark ? 'text-gray-400' : 'text-gray-400'">{{ listening ?
                            'mic' : 'smart_toy' }}</span>
                </div>
                <div v-if="listening"
                    class="absolute -inset-4 rounded-full border border-ai-blue/20 animate-ping opacity-40"></div>
            </div>

            <!-- Text -->
            <div class="text-center px-4">
                <p class="text-lg font-bold" :class="isDark ? 'text-white' : 'text-gray-800'">{{ listening ?
                    'Listening...' : 'Say a command' }}</p>
                <p v-if="transcript && listening" class="text-base mt-2 font-medium text-ai-blue">
                    "{{ transcript }}"
                </p>
                <p v-else class="text-sm mt-2 italic" :class="isDark ? 'text-gray-400' : 'text-gray-500'">
                    {{ lastCommand || '"Navigate" • "Chat" • "Wallet" • "Fuel" • "SOS"' }}
                </p>
            </div>

            <!-- Suggestion Chips -->
            <div class="w-full flex flex-wrap gap-2 justify-center">
                <button v-for="cmd in commands" :key="cmd" @click="handleCommand(cmd)"
                    class="text-xs font-semibold px-4 py-2 rounded-full border transition-all active:scale-95"
                    :class="isDark ? 'border-ai-blue/20 bg-ai-blue/8 text-ai-blue hover:bg-ai-blue/15' : 'border-blue-200 bg-blue-50 text-blue-600 hover:bg-blue-100'">
                    ✦ {{ cmd }}
                </button>
            </div>
        </div>

        <!-- Mic Button Footer -->
        <div class="screen-footer flex justify-center py-6"
            :class="isDark ? 'bg-background-dark' : 'bg-background-light'">
            <button @click="toggleListen"
                class="w-20 h-20 rounded-full flex items-center justify-center text-3xl transition-all active:scale-[0.97]"
                :class="listening
                    ? 'bg-red-500 text-white'
                    : isDark ? 'bg-ai-blue/20 border border-ai-blue/30 text-ai-blue' : 'bg-blue-100 border border-blue-200 text-blue-600'"
                :style="listening ? 'box-shadow: 0 0 30px rgba(239,68,68,0.5)' : ''">
                <span class="material-icons text-4xl">{{ listening ? 'stop' : 'mic' }}</span>
            </button>
        </div>
    </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted } from 'vue'
import { useRouter } from 'vue-router'
import { useUiStore } from '../stores/uiStore.js'
import { useJobStore } from '../stores/jobStore.js'
import { useRouteStore } from '../stores/routeStore.js'
import { openExternalNavigation } from '../utils/navigation.js'
import { SpeechRecognition } from '@capacitor-community/speech-recognition'
import { Capacitor } from '@capacitor/core'

const router = useRouter()
const uiStore = useUiStore()
const jobStore = useJobStore()
const routeStore = useRouteStore()
const isDark = computed(() => uiStore.theme !== 'light')

const listening = ref(false)
const lastCommand = ref('')
const transcript = ref('')
const hasPermission = ref(false)

// Voice commands with aliases for flexible matching
const commands = [
    'Navigate to next stop',
    'Open dispatcher chat',
    'What is my ETA?',
    'Log fuel receipt',
    'Report route deviation',
    'Activate SOS',
]

const commandRoutes = {
    'Navigate to next stop': '/navigation',
    'Open dispatcher chat': '/chat',
    'Log fuel receipt': '/fuel-receipt',
    'Report route deviation': '/route-deviation',
    'Activate SOS': '/crisis',
}

// Extended command matching - maps spoken phrases to commands
const voiceCommandMappings = {
    // Navigation
    'navigate': 'Navigate to next stop',
    'navigation': 'Navigate to next stop',
    'next stop': 'Navigate to next stop',
    'go to next stop': 'Navigate to next stop',
    'take me to next stop': 'Navigate to next stop',
    'directions': 'Navigate to next stop',
    'start navigation': 'Navigate to next stop',
    'open navigation': 'Navigate to next stop',
    'maps': 'Navigate to next stop',
    'open maps': 'Navigate to next stop',
    
    // Dispatcher chat
    'chat': 'Open dispatcher chat',
    'dispatcher': 'Open dispatcher chat',
    'open chat': 'Open dispatcher chat',
    'message dispatcher': 'Open dispatcher chat',
    'talk to dispatcher': 'Open dispatcher chat',
    'contact dispatcher': 'Open dispatcher chat',
    'dispatch': 'Open dispatcher chat',
    'open dispatch': 'Open dispatcher chat',
    
    // ETA
    'eta': 'What is my ETA?',
    'what is my eta': 'What is my ETA?',
    'estimated time': 'What is my ETA?',
    'arrival time': 'What is my ETA?',
    'when will i arrive': 'What is my ETA?',
    'how long': 'What is my ETA?',
    
    // Fuel receipt
    'fuel': 'Log fuel receipt',
    'fuel receipt': 'Log fuel receipt',
    'log fuel': 'Log fuel receipt',
    'add fuel': 'Log fuel receipt',
    'petrol': 'Log fuel receipt',
    'diesel': 'Log fuel receipt',
    'gas': 'Log fuel receipt',
    'refuel': 'Log fuel receipt',
    
    // Route deviation
    'deviation': 'Report route deviation',
    'route deviation': 'Report route deviation',
    'report deviation': 'Report route deviation',
    'wrong route': 'Report route deviation',
    'detour': 'Report route deviation',
    'alternate route': 'Report route deviation',
    
    // SOS / Crisis
    'sos': 'Activate SOS',
    'emergency': 'Activate SOS',
    'help': 'Activate SOS',
    'crisis': 'Activate SOS',
    'activate sos': 'Activate SOS',
    'accident': 'Activate SOS',
    'problem': 'Activate SOS',
    
    // Additional navigation targets
    'wallet': '/wallet',
    'open wallet': '/wallet',
    'my wallet': '/wallet',
    'earnings': '/wallet',
    'money': '/wallet',
    'payment': '/wallet',
    
    'home': '/dashboard',
    'dashboard': '/dashboard',
    'go home': '/dashboard',
    'main screen': '/dashboard',
    
    'manifest': '/manifest',
    'open manifest': '/manifest',
    'deliveries': '/manifest',
    'my deliveries': '/manifest',
    'stops': '/manifest',
    'my stops': '/manifest',
    
    'crew': '/crew',
    'open crew': '/crew',
    'team': '/crew',
    'my team': '/crew',
    
    'notifications': '/notifications',
    'alerts': '/notifications',
    'messages': '/notifications',
    'open notifications': '/notifications',
    
    'settings': '/settings',
    'open settings': '/settings',
    'preferences': '/settings',
    
    'summary': '/shift-summary',
    'shift summary': '/shift-summary',
    'my summary': '/shift-summary',
    'end shift': '/shift-summary',
    
    'audit': '/audit',
    'audit log': '/audit',
    'history': '/audit',
    
    'offline': '/offline',
    'offline queue': '/offline',
    'pending': '/offline',
}

async function checkPermission() {
    if (!Capacitor.isNativePlatform()) {
        // Web fallback - check Web Speech API
        return !!(window.SpeechRecognition || window.webkitSpeechRecognition)
    }
    
    try {
        const { speechRecognition } = await SpeechRecognition.checkPermissions()
        if (speechRecognition === 'granted') {
            hasPermission.value = true
            return true
        }
        
        // Request permission
        const result = await SpeechRecognition.requestPermissions()
        hasPermission.value = result.speechRecognition === 'granted'
        return hasPermission.value
    } catch (e) {
        console.error('Permission check failed:', e)
        return false
    }
}

let autoStopTimer = null
let lastTranscriptTime = 0

async function startListening() {
    if (!Capacitor.isNativePlatform()) {
        // Web fallback
        startWebSpeechRecognition()
        return
    }
    
    try {
        const available = await SpeechRecognition.available()
        if (!available.available) {
            uiStore.showToast('Speech recognition not available on this device', 'error', 3000)
            return
        }
        
        const permitted = await checkPermission()
        if (!permitted) {
            uiStore.showToast('Microphone permission denied', 'error', 3000)
            return
        }
        
        listening.value = true
        transcript.value = ''
        lastTranscriptTime = 0
        
        // Remove any existing listeners
        SpeechRecognition.removeAllListeners()
        
        // Listen for partial results
        SpeechRecognition.addListener('partialResults', (data) => {
            if (data.matches && data.matches.length > 0) {
                transcript.value = data.matches[0]
                lastCommand.value = data.matches[0]
                lastTranscriptTime = Date.now()
                
                // Reset auto-stop timer on each new result
                if (autoStopTimer) {
                    clearTimeout(autoStopTimer)
                }
                
                // Auto-stop 1.5 seconds after last speech detected
                autoStopTimer = setTimeout(() => {
                    if (listening.value && transcript.value) {
                        stopListening()
                    }
                }, 1500)
            }
        })
        
        // Start listening
        await SpeechRecognition.start({
            language: 'en-US',
            maxResults: 3,
            prompt: 'Say a command...',
            partialResults: true,
            popup: false,
        })
        
        // Fallback: auto-stop after 8 seconds if no speech detected
        setTimeout(() => {
            if (listening.value) {
                if (transcript.value) {
                    stopListening()
                } else {
                    listening.value = false
                    SpeechRecognition.stop().catch(() => {})
                    uiStore.showToast('No speech detected. Try again.', 'warning', 2000)
                }
            }
        }, 8000)
        
    } catch (e) {
        console.error('Start listening error:', e)
        listening.value = false
        uiStore.showToast('Could not start voice recognition: ' + (e.message || e), 'error', 3000)
    }
}

async function stopListening() {
    if (!Capacitor.isNativePlatform()) {
        stopWebSpeechRecognition()
        return
    }
    
    // Clear auto-stop timer
    if (autoStopTimer) {
        clearTimeout(autoStopTimer)
        autoStopTimer = null
    }
    
    // Save transcript before stopping (in case stop() clears it)
    const savedTranscript = transcript.value
    
    try {
        // Remove listeners first
        SpeechRecognition.removeAllListeners()
        
        const result = await SpeechRecognition.stop()
        listening.value = false
        
        // Process the result - try multiple sources
        let textToProcess = null
        
        if (result && result.matches && result.matches.length > 0) {
            textToProcess = result.matches[0]
        } else if (savedTranscript) {
            textToProcess = savedTranscript
        }
        
        if (textToProcess) {
            console.log('Processing transcript:', textToProcess)
            processVoiceCommand(textToProcess.toLowerCase().trim())
        } else {
            uiStore.showToast('No speech detected', 'warning', 2000)
        }
        
    } catch (e) {
        console.error('Stop listening error:', e)
        listening.value = false
        
        // Still try to process saved transcript on error
        if (savedTranscript) {
            console.log('Processing saved transcript after error:', savedTranscript)
            processVoiceCommand(savedTranscript.toLowerCase().trim())
        }
    }
}

// Web Speech API fallback for browser testing
let webRecognition = null

function startWebSpeechRecognition() {
    const SpeechRecognitionAPI = window.SpeechRecognition || window.webkitSpeechRecognition
    if (!SpeechRecognitionAPI) {
        uiStore.showToast('Speech recognition not supported in browser', 'error', 3000)
        return
    }
    
    webRecognition = new SpeechRecognitionAPI()
    webRecognition.continuous = false
    webRecognition.interimResults = true
    webRecognition.lang = 'en-US'
    
    webRecognition.onstart = () => {
        listening.value = true
        transcript.value = ''
    }
    
    webRecognition.onresult = (event) => {
        let finalTranscript = ''
        for (let i = event.resultIndex; i < event.results.length; i++) {
            if (event.results[i].isFinal) {
                finalTranscript += event.results[i][0].transcript
            } else {
                transcript.value = event.results[i][0].transcript
                lastCommand.value = transcript.value
            }
        }
        if (finalTranscript) {
            transcript.value = finalTranscript
            lastCommand.value = finalTranscript
            processVoiceCommand(finalTranscript.toLowerCase().trim())
        }
    }
    
    webRecognition.onerror = (event) => {
        console.error('Web speech error:', event.error)
        listening.value = false
        if (event.error === 'not-allowed') {
            uiStore.showToast('Microphone permission denied', 'error', 3000)
        } else {
            uiStore.showToast('Voice recognition error: ' + event.error, 'error', 2000)
        }
    }
    
    webRecognition.onend = () => {
        listening.value = false
    }
    
    try {
        webRecognition.start()
    } catch (e) {
        uiStore.showToast('Could not start voice recognition', 'error', 2000)
    }
}

function stopWebSpeechRecognition() {
    if (webRecognition) {
        webRecognition.stop()
        listening.value = false
    }
}

function processVoiceCommand(spokenText) {
    console.log('Processing voice command:', spokenText)
    uiStore.showToast(`Processing: "${spokenText}"`, 'info', 1000)
    
    // Try to find a matching command
    let matchedCommand = null
    let matchedRoute = null
    
    // First, check exact matches
    for (const [phrase, command] of Object.entries(voiceCommandMappings)) {
        if (spokenText.includes(phrase)) {
            if (command.startsWith('/')) {
                // Direct route
                matchedRoute = command
            } else {
                // Mapped to a command
                matchedCommand = command
            }
            break
        }
    }
    
    // If no match, try fuzzy matching on command names
    if (!matchedCommand && !matchedRoute) {
        for (const cmd of commands) {
            if (spokenText.includes(cmd.toLowerCase())) {
                matchedCommand = cmd
                break
            }
        }
    }
    
    if (matchedCommand) {
        lastCommand.value = `✦ ${matchedCommand}`
        uiStore.showToast(`✦ CargoAI: ${matchedCommand}`, 'success', 1500)
        
        if (matchedCommand === 'Navigate to next stop') {
            setTimeout(() => openNextStopNavigation(), 600)
        } else if (matchedCommand === 'What is my ETA?') {
            // Show ETA info
            const eta = routeStore.currentStop?.eta || jobStore.currentStop?.eta || 'Unknown'
            uiStore.showToast(`✦ Your ETA is: ${eta}`, 'info', 3000)
        } else {
            const route = commandRoutes[matchedCommand]
            if (route) {
                setTimeout(() => {
                    console.log('Navigating to:', route)
                    router.push(route)
                }, 600)
            }
        }
    } else if (matchedRoute) {
        const routeName = matchedRoute.replace('/', '').replace(/-/g, ' ')
        lastCommand.value = `✦ Opening ${routeName}`
        uiStore.showToast(`✦ CargoAI: Opening ${routeName}`, 'success', 1500)
        setTimeout(() => {
            console.log('Navigating to route:', matchedRoute)
            router.push(matchedRoute)
        }, 600)
    } else {
        lastCommand.value = `"${spokenText}" - Not recognized`
        uiStore.showToast(`Not recognized: "${spokenText}"`, 'warning', 2500)
    }
}

async function toggleListen() {
    if (listening.value) {
        // User pressed stop - process immediately with current transcript
        const textToProcess = transcript.value
        
        // Clear timers
        if (autoStopTimer) {
            clearTimeout(autoStopTimer)
            autoStopTimer = null
        }
        
        // Stop recognition
        listening.value = false
        try {
            SpeechRecognition.removeAllListeners()
            await SpeechRecognition.stop()
        } catch (e) {
            console.log('Stop error (ignored):', e)
        }
        
        // Process the command
        if (textToProcess) {
            processVoiceCommand(textToProcess.toLowerCase().trim())
        } else {
            uiStore.showToast('No speech detected', 'warning', 2000)
        }
    } else {
        await startListening()
    }
}

function handleCommand(cmd) {
    lastCommand.value = cmd
    uiStore.showToast(`✦ CargoAI: ${cmd}`, 'info')
    if (cmd === 'Navigate to next stop') {
        setTimeout(() => openNextStopNavigation(), 600)
        return
    }
    if (cmd === 'What is my ETA?') {
        const eta = routeStore.currentStop?.eta || jobStore.currentStop?.eta || 'Unknown'
        uiStore.showToast(`✦ Your ETA is: ${eta}`, 'info', 3000)
        return
    }
    const route = commandRoutes[cmd]
    if (route) {
        setTimeout(() => router.push(route), 600)
    }
}

function openNextStopNavigation() {
    const currentStop = routeStore.currentStop
        || jobStore.currentStop
        || jobStore.jobData?.stops?.[0]
        || routeStore.stops?.[0]

    if (!currentStop) {
        uiStore.showToast('No stop available for navigation', 'error', 2200)
        return
    }

    if (!routeStore.stops.length && jobStore.jobData?.stops?.length) {
        routeStore.loadManifest({
            routeId: routeStore.manifest?.routeId || jobStore.jobData?.manifestId || null,
            endTime: routeStore.manifest?.endTime || '--:--',
            stops: jobStore.jobData.stops,
        })
    }

    if (!routeStore.isRouteActive) {
        routeStore.startRoute()
    }

    jobStore.setCurrentStopById(currentStop.id)
    routeStore.setCurrentStopById(currentStop.id)
    jobStore.ensureTransitState({
        startedAt: new Date().toISOString(),
        stopId: currentStop.id,
    })

    try {
        openExternalNavigation(currentStop)
    } catch (error) {
        uiStore.showToast(error.message || 'Unable to open maps', 'error', 2400)
        router.push('/navigation')
    }
}

onMounted(async () => {
    // Check permission on mount
    await checkPermission()
})

onUnmounted(() => {
    if (listening.value) {
        stopListening()
    }
})
</script>
