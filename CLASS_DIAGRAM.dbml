// ============================================================
// CLASS DIAGRAM - Cargo-Core Logistics Platform
// Paste this into https://dbdiagram.io
// ============================================================

Table roles {
  id integer [pk, increment]
  name varchar(50) [unique, not null]
}

Table users {
  id uuid [pk]
  name varchar(255) [not null]
  username varchar(64) [unique, not null]
  email varchar(255) [unique, not null]
  phone varchar(20)
  date_of_birth date
  address text
  password_hash varchar(255) [not null]
  role_id integer [not null, ref: > roles.id]
  warehouse_id uuid
  is_active boolean [default: true]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table warehouses {
  id uuid [pk]
  name varchar(255) [unique, not null]
  address text [not null]
  lat float
  lng float
  manager_id uuid [ref: > users.id]
  floor_plan_json jsonb
  capacity_limit integer
  is_active boolean [default: true]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Ref: users.warehouse_id > warehouses.id

Table orders {
  id uuid [pk]
  tracking_code varchar(32) [unique, not null]
  order_type varchar(20) [not null]
  status varchar(20) [not null, default: "DRAFT"]
  warehouse_substatus varchar(30)
  customer_id uuid [not null, ref: > users.id]
  warehouse_id uuid [ref: > warehouses.id]
  assigned_driver_id uuid [ref: > users.id]
  assigned_vehicle_id uuid
  pickup_addr text [not null]
  delivery_addr text [not null]
  cargo_type varchar(100)
  vehicle_type varchar(50)
  labor_count integer [default: 0]
  base_amount float [default: 0]
  vehicle_amount float [default: 0]
  labor_amount float [default: 0]
  materials_amount float [default: 0]
  packing_amount float [default: 0]
  platform_fee float [default: 0]
  tax_amount float [default: 0]
  total_amount float [default: 0]
  payment_mode varchar(30)
  payment_status varchar(20) [default: "pending"]
  service_otp varchar(10)
  service_time_block varchar(50)
  scheduled_at timestamptz
  cancel_reason text
  picking_started_at timestamptz
  picking_completed_at timestamptz
  packing_started_at timestamptz
  packing_completed_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  sku varchar(64) [not null]
  quantity integer [not null]
  box_count integer
  estimated_volume float
  created_at timestamptz [default: `now()`]

  indexes {
    (order_id, sku) [unique]
  }
}

Table picked_items {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  sku varchar(64) [not null]
  quantity_picked integer [default: 0]
  quantity_required integer [not null]
  picked_by uuid [ref: > users.id]
  location varchar(200)
  notes text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (order_id, sku) [unique]
  }
}

Table customer_quotes {
  id uuid [pk]
  reference_code varchar(32) [unique, not null]
  customer_id uuid [not null, ref: > users.id]
  cargo_type varchar(100) [not null]
  from_location text [not null]
  to_location text [not null]
  labor_count integer [default: 0]
  packing boolean [default: false]
  total_amount float [default: 0]
  status varchar(20) [default: "active"]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table damage_reports {
  id uuid [pk]
  reference_code varchar(32) [unique, not null]
  customer_id uuid [not null, ref: > users.id]
  order_id uuid [ref: > orders.id]
  description text [not null]
  photos json
  status varchar(20) [default: "reported"]
  qr_code varchar(64) [unique, not null]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// ── INVENTORY ────────────────────────────────────────────────

Table inventory_items {
  id uuid [pk]
  warehouse_id uuid [not null, ref: > warehouses.id]
  sku varchar(64) [not null]
  name varchar(255) [not null]
  category varchar(100)
  unit varchar(30) [default: "pcs"]
  quantity_on_hand integer [default: 0]
  safety_stock integer [default: 0]
  aisle varchar(30)
  shelf varchar(30)
  bin varchar(30)
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (warehouse_id, sku) [unique]
  }
}

Table inventory_movements {
  id uuid [pk]
  item_id uuid [not null, ref: > inventory_items.id]
  movement_type varchar(20) [not null]
  quantity integer [not null]
  reference_order_id uuid [ref: > orders.id]
  performed_by uuid [ref: > users.id]
  created_at timestamptz [default: `now()`]
}

Table restock_requests {
  id uuid [pk]
  item_id uuid [not null, ref: > inventory_items.id]
  warehouse_id uuid [not null, ref: > warehouses.id]
  quantity integer [not null]
  status varchar(20) [default: "PENDING"]
  requested_by uuid [ref: > users.id]
  manager_notes text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// ── WAREHOUSE OPERATIONS ─────────────────────────────────────

Table labourers {
  id uuid [pk]
  user_id uuid [unique, not null, ref: > users.id]
  warehouse_id uuid [not null, ref: > warehouses.id]
  assigned_order_id uuid [ref: > orders.id]
  skill_tags jsonb
  is_active boolean [default: true]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table labour_attendance {
  id uuid [pk]
  labourer_id uuid [not null, ref: > labourers.id]
  event_type varchar(20) [not null]
  created_at timestamptz [default: `now()`]
}

Table loading_docks {
  id uuid [pk]
  warehouse_id uuid [not null, ref: > warehouses.id]
  dock_number varchar(20) [not null]
  status varchar(30) [default: "FREE"]
  assigned_truck_id varchar(50)
  assigned_carrier varchar(100)
  assigned_order_id uuid [ref: > orders.id]
  arrived_at timestamptz
  loading_started_at timestamptz
  released_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table packing_stations {
  id uuid [pk]
  warehouse_id uuid [not null, ref: > warehouses.id]
  station_number varchar(30) [not null]
  status varchar(20) [default: "CLOSED"]
  assigned_labourer_id uuid [ref: > labourers.id]
  current_order_id uuid [ref: > orders.id]
  items_packed_today integer [default: 0]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table quality_checks {
  id uuid [pk]
  order_id uuid [unique, not null, ref: > orders.id]
  warehouse_id uuid [not null, ref: > warehouses.id]
  performed_by uuid [ref: > users.id]
  goods_correct boolean [default: false]
  count_correct boolean [default: false]
  packaging_verified boolean [default: false]
  labor_assigned boolean [default: false]
  weight_verified boolean [default: false]
  label_attached boolean [default: false]
  is_passed boolean [default: false]
  notes text
  checked_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table return_gradings {
  id uuid [pk]
  warehouse_id uuid [not null, ref: > warehouses.id]
  order_id uuid [ref: > orders.id]
  rma_code varchar(50) [unique, not null]
  item_condition varchar(50) [not null]
  condition_notes text
  disposition varchar(30) [not null]
  damage_photo_url varchar(500)
  graded_by uuid [ref: > users.id]
  graded_at timestamptz
  status varchar(20) [default: "pending"]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table warehouse_zone_metrics {
  id uuid [pk]
  warehouse_id uuid [not null, ref: > warehouses.id]
  zone_id varchar(100) [not null]
  metric_date date [not null]
  orders_processed integer [default: 0]
  picking_accuracy_pct float [default: 0]
  active_pickers integer [default: 0]
  capacity_used_pct float [default: 0]
  throughput_items_per_hour float [default: 0]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// ── LOGISTICS ────────────────────────────────────────────────

Table logistics_driver_profiles {
  id uuid [pk]
  user_id uuid [unique, not null, ref: > users.id]
  warehouse_id uuid [ref: > warehouses.id]
  status varchar(30) [default: "Active"]
  current_location varchar(255)
  current_job varchar(255)
  efficiency_score integer [default: 85]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table logistics_vehicles {
  id uuid [pk]
  code varchar(50) [unique, not null]
  vehicle_type varchar(100) [not null]
  warehouse_id uuid [ref: > warehouses.id]
  assigned_driver_id uuid [ref: > users.id]
  model varchar(100)
  year integer
  license_plate varchar(50)
  status varchar(30) [default: "Active"]
  mileage integer [default: 0]
  next_service_date timestamptz
  maintenance_issue varchar(255)
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table logistics_zones {
  id uuid [pk]
  warehouse_id uuid [not null, ref: > warehouses.id]
  name varchar(255) [not null]
  zone_type varchar(50) [default: "Polygon"]
  radius_km float
  status varchar(30) [default: "Active"]
  color_token varchar(30)
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table logistics_transactions {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  transaction_code varchar(50) [unique, not null]
  transaction_date timestamptz [default: `now()`]
  description varchar(255) [not null]
  transaction_type varchar(50) [not null]
  amount float [default: 0]
  status varchar(30) [default: "Completed"]
  metadata_json jsonb
  created_at timestamptz [default: `now()`]
}

Table logistics_alerts {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  alert_type varchar(50) [not null]
  title varchar(255) [not null]
  description text [not null]
  severity varchar(20) [default: "medium"]
  location varchar(255)
  recommendation text
  is_active boolean [default: true]
  created_at timestamptz [default: `now()`]
}

Table logistics_chat_threads {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  name varchar(255) [not null]
  status varchar(30) [default: "Online"]
  phone varchar(20)
  muted boolean [default: false]
  last_message text
  last_message_at timestamptz
  created_at timestamptz [default: `now()`]
}

Table logistics_chat_messages {
  id uuid [pk]
  thread_id uuid [not null, ref: > logistics_chat_threads.id]
  sender varchar(30) [not null]
  text text [not null]
  created_at timestamptz [default: `now()`]
}

Table logistics_escalations {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  title varchar(255) [not null]
  priority varchar(20) [default: "Medium"]
  requester_name varchar(255) [not null]
  requester_role varchar(100) [not null]
  description text [not null]
  action_details text
  status varchar(30) [default: "OPEN"]
  created_at timestamptz [default: `now()`]
}

Table logistics_return_cases {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  order_id uuid [ref: > orders.id]
  reference_code varchar(50) [unique, not null]
  customer_name varchar(255) [not null]
  reason varchar(255) [not null]
  condition varchar(100) [not null]
  status varchar(30) [default: "Pending"]
  original_price float [default: 0]
  refund_amount float [default: 0]
  images jsonb
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table logistics_daily_stats {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  stat_date date [not null]
  orders_count integer [default: 0]
  revenue float [default: 0]
  deliveries_completed integer [default: 0]
  deliveries_failed integer [default: 0]
  sla_compliance float [default: 0]
  created_at timestamptz [default: `now()`]
}

Table logistics_metrics {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  metric_type varchar(50) [not null]
  label varchar(100) [not null]
  value_main float [not null]
  value_secondary float
  created_at timestamptz [default: `now()`]
}

Table logistics_equipment_ledger {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  item_type varchar(50) [not null]
  issued_count integer [default: 0]
  returned_count integer [default: 0]
  reference_code varchar(50)
  status varchar(30) [default: "Pending"]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table logistics_documents {
  id uuid [pk]
  entity_type varchar(50) [not null]
  entity_id varchar(50) [not null]
  hub_id uuid [ref: > warehouses.id]
  doc_type varchar(100) [not null]
  document_url text
  status varchar(50) [default: "Pending Verification"]
  expiry_date timestamptz
  notes text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

// ── VENDOR ───────────────────────────────────────────────────

Table vendor_team_members {
  id uuid [pk]
  vendor_id uuid [not null, ref: > users.id]
  name varchar(255) [not null]
  email varchar(255) [not null]
  role varchar(50) [default: "Viewer"]
  status varchar(30) [default: "Invited"]
  created_at timestamptz [default: `now()`]
}


Table vendor_recurring_rules {
  id uuid [pk]
  vendor_id uuid [not null, ref: > users.id]
  name varchar(255) [not null]
  description text
  frequency varchar(100) [not null]
  route varchar(255) [not null]
  next_run varchar(100) [not null]
  active boolean [default: true]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table vendor_bulk_uploads {
  id uuid [pk]
  vendor_id uuid [not null, ref: > users.id]
  filename varchar(255) [not null]
  file_size_kb integer [default: 0]
  orders integer [default: 0]
  status varchar(30) [default: "Processed"]
  errors integer [default: 0]
  created_at timestamptz [default: `now()`]
}

Table vendor_support_tickets {
  id uuid [pk]
  vendor_id uuid [not null, ref: > users.id]
  order_id uuid [ref: > orders.id]
  subject varchar(255) [not null]
  description text [not null]
  priority varchar(30) [default: "Medium"]
  status varchar(30) [default: "Open"]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}

Table vendor_support_replies {
  id uuid [pk]
  ticket_id uuid [not null, ref: > vendor_support_tickets.id]
  from_name varchar(100) [not null]
  message text [not null]
  created_at timestamptz [default: `now()`]
}

// ── AI / ESCALATIONS ─────────────────────────────────────────

Table ai_conversations {
  id uuid [pk]
  session_id uuid [not null]
  user_id uuid [not null, ref: > users.id]
  role varchar(20) [not null]
  message text [not null]
  intent varchar(50)
  sql_generated text
  query_result json
  created_at timestamptz [default: `now()`]
}

Table escalations {
  id uuid [pk]
  conversation_id uuid [not null, ref: > ai_conversations.id]
  reason text [not null]
  escalated_to_user_id uuid [ref: > users.id]
  escalated_at timestamptz [default: `now()`]
  resolved_at timestamptz
  status varchar(20) [default: "OPEN"]
}

// ── RATE & PRICING GOVERNANCE ─────────────────────────────

Table rate_governance {
  id uuid [pk]
  warehouse_id uuid [ref: > warehouses.id]
  base_booking_fee decimal [default: 0]
  per_km_rate decimal [default: 0]
  min_charge decimal [default: 0]
  per_labourer_per_hour decimal [default: 0]
  fuel_surcharge_pct decimal [default: 0]
  peak_multiplier decimal [default: 1]
  vehicle_rates jsonb
  is_active boolean [default: true]
  updated_by uuid [ref: > users.id]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
}
